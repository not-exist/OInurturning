{
  "name": "oinurturning",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter './apps/*' dev",
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "test:unit": "pnpm --filter @oinur/api test:unit",
    "test:integration": "pnpm --filter @oinur/api test:integration",
    "test:coverage": "pnpm --filter @oinur/api test:coverage",
    "test:watch": "pnpm --filter @oinur/api test:watch",
    "test:e2e": "pnpm --filter @oinur/api test:e2e",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "db:up": "docker compose up -d && until docker compose exec mysql mysqladmin ping -h 127.0.0.1 -uoinur -poinur --silent >/dev/null 2>&1; do sleep 1; done && pnpm db:migrate && echo mysql-ready",
    "bootstrap:offline": "node scripts/dev-bootstrap.mjs",
    "db:migrate": "pnpm -C apps/api migrate",
    "sim:economy": "pnpm -C apps/api exec tsx ../../scripts/sim-economy.ts",
    "bal:regress": "pnpm -C apps/api exec tsx ../../scripts/balance-regression.ts",
    "secret": "node scripts/gen-secret.mjs",
    "admin:set": "pnpm -C apps/api admin:set",
    "e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "e2e:typecheck": "tsc --noEmit -p tests/e2e/tsconfig.json",
    "e2e:seed": "pnpm -C apps/api e2e:seed"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "typescript-eslint": "^8.70.0",
    "typescript": "^6.0.3"
  }
}
