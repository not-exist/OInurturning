# ---- 数据库 ----
MYSQL_DATABASE=oinur
MYSQL_USER=oinur
MYSQL_PASSWORD=oinur
MYSQL_ROOT_PASSWORD=change-me-root
DATABASE_URL="mysql://oinur:oinur@localhost:3306/oinur"
# ---- 认证 ----
# 生产必须用强随机密钥：pnpm secret 生成后替换（至少 32 字节）。
# 注意：NODE_ENV=production 下示例/占位值会拒绝启动（change-me-… / xxxxxxx）。
JWT_SECRET=change-me-at-least-32-chars-random-xxxxxxx
BCRYPT_COST=12
# ---- 服务 ----
PORT=3000
NODE_ENV=development
# API 位于 nginx/Caddy/负载均衡之后时，填写可信反代层数（deploy compose 默认 1）。
# 该值用于识别 HTTPS 并给 refresh cookie 加 Secure；直接运行 API 时保持 0。
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
# ---- 限流（可选，缺省即文档基线；单位：次/窗口毫秒） ----
# RATE_LIMIT_GLOBAL_MAX=300
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_AUTH_WINDOW_MS=900000
