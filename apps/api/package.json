{
  "name": "@oinur/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "seed": "node --import tsx --env-file=../../.env src/scripts/seed.ts",
    "admin:set": "node --import tsx --env-file=../../.env src/scripts/set-admin.ts",
    "onboarding:backfill": "node --import tsx --env-file=../../.env src/scripts/grant-onboarding-backfill.ts",
    "migrate": "prisma migrate deploy",
    "generate": "prisma generate",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.unit.ts",
    "test:integration": "vitest run --config vitest.config.ts",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:watch:unit": "vitest --config vitest.config.unit.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:coverage:unit": "vitest run --config vitest.config.unit.ts --coverage",
    "e2e:seed": "node --import tsx src/scripts/e2e-seed.ts",
    "lint": "eslint src/ tests/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@oinur/shared": "workspace:*",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mariadb": "^3.5.4",
    "pino": "^10.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.1",
    "pino-pretty": "^13.0.0",
    "prisma": "^7.10.0",
    "supertest": "^7.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
